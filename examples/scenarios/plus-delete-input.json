{
  "qa": {
    "id": "shopping-delete",
    "goal": "购物后验证归属限制、真实删除和重复删除",
    "natural_language": "# 加入并移除购物车（独立 E2E）\n\n普通用户 U1=2001 从首页开始，另有 U2=2002 验证用户隔离。商品 P1=1001 已上架，名称“测试键盘”，单价99元人民币，库存10；两个用户购物车均为空。\n\n1. U1 打开首页，看到测试键盘，价格99元。\n2. 点击商品，详情展示相同名称、价格和库存10。\n3. 加入1件，返回201，有稳定购物车记录标识5001，数量1。\n4. 打开购物车，只有一条记录，数量1，合计99元。\n5. 再加入1件，返回200，记录标识相同，数量2，合计198元。\n6. U2 查看购物车，应为空；商品库存仍为10。\n7. U2 请求移除U1的记录5001，返回404。U1的购物车仍有一条记录、数量2。\n8. U1 移除自己的记录5001，返回204。再次查看购物车为空，合计0。\n9. U1 再移除同一记录，返回404。商品详情仍存在、库存仍为10。\n\n前六步沿用购物场景的全部预期，本独立用例增加真实删除和重复删除。结束时两个用户购物车都为空、商品仍存在。每次运行创建新环境；上述步骤共享状态。不得预装购物车终态，不得将删除请求直接替换成HTTP成功响应。名称、价格、数量、用户归属、库存和预期固定；不配置额外模型API。业务流程异常、并发和底层事务回滚由独立验收覆盖。\n",
    "start_page": "/",
    "role": "U1=2001 已登录；U2=2002 已登录",
    "initial_state": "P1=1001 已上架，测试键盘，99 元，库存10；两个用户购物车为空",
    "data_policy": "QA 名称、价格、库存和预期固定；使用约定的内部 ID",
    "write_rules": "重复加入累计数量并保留同一记录；不扣库存；仅本人能删除购物车记录，重复删除404，商品保留",
    "coverage": "首页、详情、首次与重复加入、购物车、多用户；异常及并发另测；删除、删除后的查询、重复删除和用户隔离",
    "steps": [
      {
        "id": "S1",
        "action": "打开首页",
        "expected": "测试键盘，99 元"
      },
      {
        "id": "S2",
        "action": "点击测试键盘",
        "expected": "同商品、同价格、库存 10"
      },
      {
        "id": "S3",
        "action": "数量 1 加入购物车",
        "expected": "HTTP 201，稳定记录标识，数量 1"
      },
      {
        "id": "S4",
        "action": "打开购物车",
        "expected": "一条记录，数量 1，合计 99 元"
      },
      {
        "id": "S5",
        "action": "返回详情再加入 1，查看购物车",
        "expected": "HTTP 200，同一记录，数量 2，合计 198 元"
      },
      {
        "id": "S6",
        "action": "U2 查看购物车",
        "expected": "为空，不含 U1 商品"
      },
      {
        "id": "S7",
        "action": "U2 删除 U1 记录",
        "expected": "404；U1 的一条记录数量仍为2"
      },
      {
        "id": "S8",
        "action": "U1 删除本人记录并查询购物车",
        "expected": "204；购物车为空，合计0"
      },
      {
        "id": "S9",
        "action": "U1 再删除并查询商品详情",
        "expected": "404；商品仍存在，库存10"
      }
    ],
    "fixed": {
      "name": "测试键盘",
      "price_cents": "9900",
      "stock": "10",
      "status": "ON_SALE"
    },
    "initial_assertions": [
      {
        "table": "cart_items",
        "where": {},
        "count": 0
      }
    ],
    "final_assertions": [
      {
        "table": "cart_items",
        "where": {},
        "count": 0
      },
      {
        "table": "products",
        "where": {
          "id": {
            "type": "BIGINT",
            "value": "1001"
          }
        },
        "count": 1,
        "fields": {
          "name": {
            "type": "VARCHAR",
            "value": "测试键盘"
          },
          "price_cents": {
            "type": "BIGINT",
            "value": "9900"
          },
          "stock": {
            "type": "BIGINT",
            "value": "10"
          },
          "status": {
            "type": "VARCHAR",
            "value": "ON_SALE"
          }
        }
      }
    ]
  },
